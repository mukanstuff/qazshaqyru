# ===== Database =====
# Внутри docker-compose сети указывается как postgres
DATABASE_URL="postgresql://invitation_user:CHANGE_ME@postgres:5432/invitation_db"

# ===== Application =====
NODE_ENV=production
APP_URL="https://invito.kz"

# ===== Security =====
# ОБЯЗАТЕЛЬНО смените! Сгенерировать: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME_32_plus_chars_openssl_rand_hex_32"
# ROTATE this value on every deploy with active sessions — see README

# ===== OTP =====
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ===== SMS Provider =====
# Options: "mock" (dev) or "twilio"
SMS_PROVIDER=mock

# Twilio (only if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ===== Admin =====
# Phone of the initial admin user (run pnpm db:seed to create)
ADMIN_PHONE="+77001234567"

# ===== Docker =====
POSTGRES_USER=invitation_user
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=invitation_db
POSTGRES_CONTAINER_NAME=invitation_db
APP_CONTAINER_NAME=invitation_app
CADDY_CONTAINER_NAME=invitation_caddy
