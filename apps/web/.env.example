# QazShaqyru — environment variables
# Local dev: cp .env.example .env  →  pnpm dev (Postgres on localhost:5432)
# Docker VPS: root .env is source of truth; keep DATABASE_URL in sync with POSTGRES_* below

# ===== Database =====
# Local (pnpm dev on host): localhost:5432
# Docker app container: postgres:5432 (set automatically by docker-compose; override only if needed)
DATABASE_URL="postgresql://invitation_user:CHANGE_ME_postgres_password@localhost:5432/invitation_db"

# ===== Application =====
# Local: NODE_ENV=development + APP_URL=http://127.0.0.1:3000 (or your next dev port)
# Docker/VPS prod: NODE_ENV=production + APP_URL=https://qazshaqyru.kz (no trailing slash)
# Before domain on VPS: http://YOUR.VPS.IP
NODE_ENV=development
APP_URL="http://127.0.0.1:3000"
TRUST_PROXY=false

# ===== Security =====
# Generate: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME_32_plus_chars_openssl_rand_hex_32"
ADMIN_API_KEY="CHANGE_ME_generate_with_openssl_rand_hex_32"

# ===== Gemini image generation =====
# Used by the art-direction/image-generation workflow
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ===== OTP =====
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ===== SMS Provider =====
# mock — local dev only (OTP in server logs / ALLOW_DEV_OTP_CODE)
# kz — Mobizon, smsc.kz, etc. (recommended for Kazakhstan)
# twilio — international
SMS_PROVIDER=mock
KZ_SMS_API_KEY=""
KZ_SMS_SENDER="QazShaqyru"
KZ_SMS_API_URL="https://api.mobizon.kz/service/message/sendsmsmessage"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ===== Kaspi Pay =====
# Credentials: https://business.kaspi.kz
# Webhook URL (register in Kaspi dashboard): {APP_URL}/api/orders/webhook/kaspi
# Webhook header: x-kaspi-signature (HMAC-SHA256 of raw body with KASPI_WEBHOOK_SECRET)
PAYMENT_PROVIDER=kaspi
ALLOW_MOCK_PAYMENT=false
KASPI_API_KEY=""
KASPI_API_URL="https://pay.kaspi.kz/api/v1"
KASPI_WEBHOOK_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"

# ===== Freedom Pay (optional) =====
FREEDOM_PAY_ENABLED=false
FREEDOM_API_KEY=""
FREEDOM_API_URL=""
FREEDOM_WEBHOOK_SECRET=""

# ===== Object storage (production uploads) =====
# When all five S3_* vars are set, uploads go to R2/S3 instead of local disk.
# Without S3: files use Docker volume public/uploads/ (UPLOAD_DISK_QUOTA_MB).
# R2 endpoint example: https://<account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL: CDN/custom domain where files are publicly readable (e.g. https://cdn.qazshaqyru.kz)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"
S3_PUBLIC_URL=""

# Local disk quota (MB) when S3 is not configured
UPLOAD_DISK_QUOTA_MB=5120

# ===== Dev only =====
# ALLOW_MOCK_PAYMENT=true
# ALLOW_DEV_OTP_CODE=true

# ===== Admin =====
ADMIN_PHONE="+77001234567"

# ===== Telegram (optional managed-order notifications) =====
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_ADMIN_CHAT_ID=""

# ===== WhatsApp =====
# Digits only, e.g. 77001234567 — shown on landing and in share flows
WHATSAPP_NUMBER="77001234567"
NEXT_PUBLIC_WHATSAPP_NUMBER="77001234567"

# Optional public Instagram profile (omit or leave empty to hide the icon — no stub #)
# NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/your_account"

# ===== Docker (mirror root .env for local tooling) =====
POSTGRES_USER=invitation_user
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=invitation_db
POSTGRES_CONTAINER_NAME=invitation_db
APP_CONTAINER_NAME=invitation_app
CADDY_CONTAINER_NAME=invitation_caddy
SCHEDULER_CONTAINER_NAME=invitation_scheduler
RECONCILE_INTERVAL_SEC=900
CLEANUP_INTERVAL_SEC=86400
RUN_MIGRATIONS=true

# ===== AI fill (optional — offline fallback if unset) =====
# OpenAI-compatible chat completions for structured invitation field fill
# AI_API_KEY=""
# OPENAI_API_KEY=""
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"

# ===== Captcha (stub — see docs/CAPTCHA_SPEC.md) =====
# Server: CAPTCHA_PROVIDER + secret key | Client widget: NEXT_PUBLIC_* mirror
CAPTCHA_PROVIDER=stub
NEXT_PUBLIC_CAPTCHA_PROVIDER=stub
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
