generator client {
  provider = "prisma-client-js"
}

// For production, append ?sslmode=require to the connection string.
// Example: postgresql://user:pass@host:5432/db?sslmode=require
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  kz
  ru
}

enum EventType {
  wedding
  toy
  betashar
  kyz_uzatu
  sundet_toy
  tusau_keser
  birthday
  anniversary
  corporate
  other
}

enum InvitationStatus {
  draft
  published
  archived
}

enum GuestResponseStatus {
  pending
  attending
  not_attending
  attending_plus_one
  /// Guest confirms attendance without children («баласыз келем»).
  attending_no_children
}

enum GuestSide {
  bride
  groom
}

enum OrderStatus {
  pending
  paid
  cancelled
  refunded
}

enum ManagedOrderStatus {
  pending
  contacted
  in_progress
  ready
  delivered
  cancelled
}

enum OrderType {
  self
  managed
}

/// Paid ladder SKUs (free is implicit / null).
enum PlanSku {
  standard
  premium
  agency
}

enum PlanScope {
  invitation
  user
}

enum SentVia {
  whatsapp
  sms
  telegram
  email
}

enum TemplateCategory {
  wedding
  toy
  betashar
  kyz_uzatu
  sundet_toy
  tusau_keser
  birthday
  anniversary
  corporate
  other
}

model User {
  id              String    @id @default(uuid())
  phone           String    @unique
  name            String?
  language        Language  @default(ru)
  isAdmin         Boolean   @default(false)
  /// Active user-level plan (agency). Invitation unlocks live on Invitation.unlockedPlanSku.
  planSku         PlanSku?
  planExpiresAt   DateTime?
  planActivatedAt DateTime?
  sessions        Session[]
  invitations     Invitation[]
  orders          Order[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([phone])
  @@index([isAdmin])
  @@index([planSku, planExpiresAt])
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  deviceInfo  String?
  ipAddress   String?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model OTPToken {
  id        String   @id @default(uuid())
  phone     String
  /// bcrypt hash of the 6-digit OTP code.
  /// The plaintext code is NEVER stored in the database.
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
  @@index([phone, usedAt])
}

model RateLimitEntry {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  blocked   Boolean  @default(false)
  blockedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([resetAt])
}

model Template {
  id              String          @id @default(uuid())
  slug            String          @unique
  nameRu          String
  nameKz          String
  descriptionRu   String?
  descriptionKz   String?
  category        TemplateCategory
  previewImageUrl String
  demoUrl         String?
  priceKzt        Int             @default(0)
  config           Json            @default("{}")
  /// Canvas document JSON (for new WYSIWYG editor-built templates). When set, template is canvas-backed.
  canvas           Json?
  mobileCanvas     Json?
  isCanvasTemplate Boolean         @default(false)
  editableConfig   Json?
  isActive         Boolean         @default(true)
  isFeatured       Boolean         @default(false)
  sortOrder        Int             @default(0)
  invitations      Invitation[]
  orders           Order[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
}

model Invitation {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId   String?
  template     Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)

  slug         String           @unique
  title        String
  eventType    EventType
  eventDate    DateTime
  eventTime    String?
  eventPlace   String?
  eventTimezone String          @default("Asia/Almaty")

  templateKey  String           @default("classic")
  templateData Json             @default("{}")
  /// Canvas document JSON for the new WYSIWYG editor (desktop layout).
  canvas       Json?
  /// Mobile override canvas; when null, renderer scales from desktop.
  mobileCanvas Json?
  musicUrl     String?

  mapUrl       String?
  address      String?

  customText   Json             @default("{}")

  status       InvitationStatus @default(draft)
  /// HMAC hash of shareable family-preview token (draft link before payment).
  previewTokenHash String?      @unique
  publishedAt  DateTime?
  archivedAt   DateTime?
  /// Incremented when guests open the public page /i/[slug].
  viewCount    Int              @default(0)

  /// Highest invitation-level paid plan unlocked for this invite (null = free/watermark).
  unlockedPlanSku PlanSku?
  unlockedAt      DateTime?
  /// Order that granted the unlock (traceability; not a formal FK to avoid dual relations).
  unlockOrderId   String?

  guests           Guest[]
  orders           Order[]
  wishes           Wish[]
  giftTransfers    GiftTransfer[]
  seatingTables    SeatingTable[]
  restaurantShares RestaurantShareLink[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([slug])
  @@index([status])
  @@index([eventDate])
  @@index([templateId])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([unlockedPlanSku])
}

model Guest {
  id            String           @id @default(uuid())
  invitationId  String
  invitation    Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  name          String
  phone         String?
  side          GuestSide?
  hasPlusOne    Boolean          @default(false)
  plusOneName   String?
  /// Optional household / family label for banquet headcount grouping.
  householdLabel String?
  /// HMAC-SHA256 of the random token we give to the guest. We never store
  /// the token itself, so leaking server logs / WhatsApp URLs / Referer
  /// headers does not let an attacker impersonate a guest.
  /// Lookup: compute hash(token) -> find by tokenHash.
  tokenHash     String           @unique

  response      GuestResponse?
  seating       SeatingAssignment?
  giftTransfers GiftTransfer[]
  /// First time the guest opened their personal invitation link.
  openedAt      DateTime?
  sentAt        DateTime?
  sentVia       SentVia?
  lastError     String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([invitationId, phone])
  @@index([invitationId])
  @@index([phone])
  @@index([tokenHash])
  @@index([invitationId, householdLabel])
}

model GuestResponse {
  id                   String              @id @default(uuid())
  guestId              String              @unique
  guest                Guest               @relation(fields: [guestId], references: [id], onDelete: Cascade)

  status               GuestResponseStatus @default(pending)
  dietaryRestrictions  String?
  message              String?

  respondedAt          DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([guestId])
  @@index([status])
}

model Order {
  id              String      @id @default(uuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String
  template        Template    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  invitationId    String?
  invitation      Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  amountKzt       Int
  currency        String      @default("KZT")
  status          OrderStatus @default(pending)
  paymentProvider String?
  paymentId       String?
  /// Provider checkout URL; stored so the user can resume payment without creating a new session.
  paymentUrl      String?
  paidAt          DateTime?
  cancelledAt     DateTime?
  refundedAt      DateTime?

  customerPhone   String
  customerName    String?
  notes           String?
  eventDate       DateTime?
  eventType       EventType?

  // Managed order (сделаем за вас)
  orderType       OrderType         @default(self)
  managedStatus   ManagedOrderStatus?
  adminNotes      String?

  /// Ladder SKU for this payment (null = legacy publication fee → treat as standard).
  planSku          PlanSku?
  planScope        PlanScope?
  planDurationDays Int?
  planExpiresAt    DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([paymentProvider, paymentId])
  @@index([userId])
  @@index([templateId])
  @@index([invitationId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([orderType, status])
  @@index([planSku])
}

/// Magic-link read-only banquet portal for restaurant / тойхана managers.
model RestaurantShareLink {
  id             String     @id @default(uuid())
  invitationId   String
  invitation     Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  /// HMAC material — plaintext token never stored.
  tokenHash      String     @unique
  label          String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  accessCount    Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([invitationId])
  @@index([invitationId, revokedAt])
}

model PaymentWebhookEvent {
  id             String   @id @default(uuid())
  provider       String
  dedupeKey      String   @unique
  orderId        String?
  paymentId      String?
  action         String
  signatureValid Boolean
  processingState String  @default("pending")
  processed      Boolean  @default(false)
  retryCount     Int      @default(0)
  lastAttemptAt  DateTime?
  lastError      String?
  receivedAt     DateTime @default(now())
  processedAt    DateTime?
  payloadHash    String

  @@index([provider, receivedAt])
  @@index([orderId, receivedAt])
}

model Wish {
  id           String     @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  authorName   String
  text         String
  reactions    WishReaction[]

  createdAt    DateTime   @default(now())

  @@index([invitationId])
  @@index([invitationId, createdAt(sort: Desc)])
}

model WishReaction {
  id        String   @id @default(uuid())
  wishId    String
  wish      Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)
  /// Hash of client fingerprint (IP + UA) — one reaction per visitor.
  likerHash String
  /// heart | pray | celebrate | clap
  emoji     String   @default("heart")

  createdAt DateTime @default(now())

  @@unique([wishId, likerHash])
  @@index([wishId])
  @@index([wishId, emoji])
}

/// Guest self-reported Kaspi gift transfer (honor system — no money through us).
model GiftTransfer {
  id              String     @id @default(uuid())
  invitationId    String
  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestId         String?
  guest           Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)
  authorName      String
  note            String?
  /// Client fingerprint hash — one ack per visitor per invitation.
  fingerprintHash String
  createdAt       DateTime   @default(now())

  @@unique([invitationId, fingerprintHash])
  @@index([invitationId, createdAt(sort: Desc)])
  @@index([guestId])
}

model SeatingTable {
  id           String              @id @default(uuid())
  invitationId String
  invitation   Invitation          @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  name         String
  capacity     Int                 @default(10)
  sortOrder    Int                 @default(0)
  /// Absolute positioning on the visual hall canvas (pixels; w/h in px; rotation degrees).
  x            Float?
  y            Float?
  w            Float?
  h            Float?
  rotation     Float?              @default(0)
  shape        String?
  tableColor   String?
  assignments  SeatingAssignment[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([invitationId, name])
  @@index([invitationId, sortOrder])
}

model SeatingAssignment {
  id        String       @id @default(uuid())
  tableId   String
  table     SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guestId   String       @unique
  guest     Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([tableId])
}

model TemplateWaitlistSignup {
  id        String   @id @default(uuid())
  slug      String
  phone     String
  createdAt DateTime @default(now())

  @@index([slug, createdAt])
}
