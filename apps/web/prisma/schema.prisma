generator client {
  provider = "prisma-client-js"
}

// For production, append ?sslmode=require to the connection string.
// Example: postgresql://user:pass@host:5432/db?sslmode=require
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  kz
  ru
}

enum EventType {
  wedding
  toy
  betashar
  kyz_uzatu
  sundet_toy
  birthday
  anniversary
  corporate
  other
}

enum InvitationStatus {
  draft
  published
  archived
}

enum GuestResponseStatus {
  pending
  attending
  not_attending
  attending_plus_one
  /// Guest confirms attendance without children («баласыз келем»).
  attending_no_children
}

enum GuestSide {
  bride
  groom
}

enum OrderStatus {
  pending
  paid
  cancelled
  refunded
}

enum ManagedOrderStatus {
  pending
  contacted
  in_progress
  ready
  delivered
  cancelled
}

enum OrderType {
  self
  managed
}

enum SentVia {
  whatsapp
  sms
  telegram
  email
}

enum TemplateCategory {
  wedding
  toy
  betashar
  kyz_uzatu
  sundet_toy
  birthday
  anniversary
  corporate
  other
}

model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  name        String?
  language    Language @default(ru)
  isAdmin     Boolean  @default(false)
  sessions    Session[]
  invitations Invitation[]
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([isAdmin])
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  deviceInfo  String?
  ipAddress   String?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model OTPToken {
  id        String   @id @default(uuid())
  phone     String
  /// bcrypt hash of the 6-digit OTP code.
  /// The plaintext code is NEVER stored in the database.
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
  @@index([phone, usedAt])
}

model RateLimitEntry {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  blocked   Boolean  @default(false)
  blockedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([resetAt])
}

model Template {
  id              String          @id @default(uuid())
  slug            String          @unique
  nameRu          String
  nameKz          String
  descriptionRu   String?
  descriptionKz   String?
  category        TemplateCategory
  previewImageUrl String
  demoUrl         String?
  priceKzt        Int             @default(0)
  config          Json            @default("{}")
  isActive        Boolean         @default(true)
  isFeatured      Boolean         @default(false)
  sortOrder       Int             @default(0)
  invitations     Invitation[]
  orders          Order[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
}

model Invitation {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId   String?
  template     Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)

  slug         String           @unique
  title        String
  eventType    EventType
  eventDate    DateTime
  eventTime    String?
  eventPlace   String?
  eventTimezone String          @default("Asia/Almaty")

  templateKey  String           @default("classic")
  templateData Json             @default("{}")
  musicUrl     String?

  mapUrl       String?
  address      String?

  customText   Json             @default("{}")

  status       InvitationStatus @default(draft)
  /// HMAC hash of shareable family-preview token (draft link before payment).
  previewTokenHash String?      @unique
  publishedAt  DateTime?
  archivedAt   DateTime?
  /// Incremented when guests open the public page /i/[slug].
  viewCount    Int              @default(0)

  guests       Guest[]
  orders       Order[]
  wishes       Wish[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([slug])
  @@index([status])
  @@index([eventDate])
  @@index([templateId])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, status, createdAt(sort: Desc)])
}

model Guest {
  id            String           @id @default(uuid())
  invitationId  String
  invitation    Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  name          String
  phone         String?
  side          GuestSide?
  hasPlusOne    Boolean          @default(false)
  plusOneName   String?
  /// HMAC-SHA256 of the random token we give to the guest. We never store
  /// the token itself, so leaking server logs / WhatsApp URLs / Referer
  /// headers does not let an attacker impersonate a guest.
  /// Lookup: compute hash(token) -> find by tokenHash.
  tokenHash     String           @unique

  response      GuestResponse?
  sentAt        DateTime?
  sentVia       SentVia?
  lastError     String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([invitationId, phone])
  @@index([invitationId])
  @@index([phone])
  @@index([tokenHash])
}

model GuestResponse {
  id                   String              @id @default(uuid())
  guestId              String              @unique
  guest                Guest               @relation(fields: [guestId], references: [id], onDelete: Cascade)

  status               GuestResponseStatus @default(pending)
  dietaryRestrictions  String?
  message              String?

  respondedAt          DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([guestId])
  @@index([status])
}

model Order {
  id              String      @id @default(uuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String
  template        Template    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  invitationId    String?
  invitation      Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  amountKzt       Int
  currency        String      @default("KZT")
  status          OrderStatus @default(pending)
  paymentProvider String?
  paymentId       String?
  /// Provider checkout URL; stored so the user can resume payment without creating a new session.
  paymentUrl      String?
  paidAt          DateTime?
  cancelledAt     DateTime?
  refundedAt      DateTime?

  customerPhone   String
  customerName    String?
  notes           String?
  eventDate       DateTime?
  eventType       EventType?

  // Managed order (сделаем за вас)
  orderType       OrderType         @default(self)
  managedStatus   ManagedOrderStatus?
  adminNotes      String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([paymentProvider, paymentId])
  @@index([userId])
  @@index([templateId])
  @@index([invitationId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([orderType, status])
}

model PaymentWebhookEvent {
  id             String   @id @default(uuid())
  provider       String
  dedupeKey      String   @unique
  orderId        String?
  paymentId      String?
  action         String
  signatureValid Boolean
  processingState String  @default("pending")
  processed      Boolean  @default(false)
  retryCount     Int      @default(0)
  lastAttemptAt  DateTime?
  lastError      String?
  receivedAt     DateTime @default(now())
  processedAt    DateTime?
  payloadHash    String

  @@index([provider, receivedAt])
  @@index([orderId, receivedAt])
}

model Wish {
  id           String     @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  authorName   String
  text         String
  reactions    WishReaction[]

  createdAt    DateTime   @default(now())

  @@index([invitationId])
  @@index([invitationId, createdAt(sort: Desc)])
}

model WishReaction {
  id        String   @id @default(uuid())
  wishId    String
  wish      Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)
  /// Hash of client fingerprint (IP + UA) — one reaction per visitor.
  likerHash String
  /// heart | pray | celebrate | clap
  emoji     String   @default("heart")

  createdAt DateTime @default(now())

  @@unique([wishId, likerHash])
  @@index([wishId])
  @@index([wishId, emoji])
}
