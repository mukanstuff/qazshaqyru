# Invito production environment (Docker Compose reads this file from repo root)
# Copy: cp .env.example .env
# Generate secrets: openssl rand -hex 32

# ===== Database (docker-compose postgres service) =====
POSTGRES_USER=invitation_user
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=invitation_db
POSTGRES_CONTAINER_NAME=invitation_db

# ===== Application =====
# Before domain: http://YOUR.VPS.IP
# After domain + DNS: https://invito.kz
APP_URL=https://invito.kz
NODE_ENV=production

# ===== Security (required) =====
SESSION_SECRET=CHANGE_ME_32_plus_chars_openssl_rand_hex_32
ADMIN_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
TRUST_PROXY=true

# ===== OTP / SMS =====
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
# Production: kz (Mobizon/smsc.kz) or twilio — never mock
SMS_PROVIDER=kz
KZ_SMS_API_KEY=
KZ_SMS_SENDER=Invito
KZ_SMS_API_URL=https://api.mobizon.kz/service/message/sendsmsmessage
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===== Payments =====
# kaspi | freedom | (empty = free templates only until configured)
# Kaspi webhook: POST {APP_URL}/api/orders/webhook/kaspi  (header: x-kaspi-signature)
PAYMENT_PROVIDER=kaspi
ALLOW_MOCK_PAYMENT=false
KASPI_API_KEY=
KASPI_API_URL=https://pay.kaspi.kz/api/v1
KASPI_WEBHOOK_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
FREEDOM_PAY_ENABLED=false
FREEDOM_API_KEY=
FREEDOM_API_URL=
FREEDOM_WEBHOOK_SECRET=

# ===== Object storage (recommended for production uploads) =====
# Cloudflare R2 or AWS S3-compatible — all five vars required together.
# Without S3: uploads use Docker volume (see UPLOAD_DISK_QUOTA_MB).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_URL=
UPLOAD_DISK_QUOTA_MB=5120

# ===== Admin seed (first deploy: RUN_SEED=true) =====
ADMIN_PHONE=+77001234567

# ===== WhatsApp (landing CTA, support — digits only) =====
WHATSAPP_NUMBER=77001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=77001234567

# ===== Optional: managed-order Telegram alerts =====
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# ===== Docker containers =====
APP_CONTAINER_NAME=invitation_app
CADDY_CONTAINER_NAME=invitation_caddy
SCHEDULER_CONTAINER_NAME=invitation_scheduler

# Scheduler: payment reconcile + DB/upload cleanup (docker service `scheduler`)
RECONCILE_INTERVAL_SEC=900
CLEANUP_INTERVAL_SEC=86400
RECONCILE_BATCH_LIMIT=100

# Captcha (stub until Turnstile wired — see apps/web/docs/CAPTCHA_SPEC.md)
CAPTCHA_PROVIDER=stub
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# First deploy only — then set RUN_SEED=false
RUN_SEED=true
RUN_MIGRATIONS=true
