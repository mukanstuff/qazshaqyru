# QazShaqyru — Caddy reverse proxy examples
# Copy the block you need to Caddyfile (repo root) before deploy.
#
# Docker Compose passes APP_URL into Caddy as {$APP_URL}.
# The app container listens on app:3000 inside the app_net network.

# ---------------------------------------------------------------------------
# Option A: Production with domain (automatic HTTPS via Let's Encrypt)
# ---------------------------------------------------------------------------
# .env:  APP_URL=https://qazshaqyru.kz
# DNS:   A record qazshaqyru.kz → VPS public IP
# Ports: 80 and 443 open in firewall
#
# {$APP_URL}
#
# reverse_proxy app:3000 {
#     header_up X-Real-IP {remote_host}
#     header_up X-Forwarded-For {proxy_add_x_forwarded_for}
#     header_up X-Forwarded-Proto {scheme}
#     transport http {
#         dial_timeout 30s
#         response_header_timeout 30s
#     }
# }
#
# encode gzip zstd
#
# request_body {
#     max_size 12MB
# }
# ^ Uncomment if large photo/music uploads fail at the proxy (app limit is 10 MB).
#
# Webhooks (Kaspi): POST /api/orders/webhook/kaspi — must reach app:3000 (no auth, signature only).
#
# @static {
#     path /_next/static/*
#     path /favicon.svg
#     path /favicon.ico
# }
#
# header @static Cache-Control "public, max-age=31536000, immutable"

# ---------------------------------------------------------------------------
# Option B: VPS without domain yet (HTTP on port 80, access by IP)
# ---------------------------------------------------------------------------
# .env:  APP_URL=http://YOUR.VPS.IP   (e.g. http://203.0.113.10)
# Replace Caddyfile content with this block (remove {$APP_URL} site block):
#
# :80 {
#     reverse_proxy app:3000 {
#         header_up X-Real-IP {remote_host}
#         header_up X-Forwarded-For {proxy_add_x_forwarded_for}
#         header_up X-Forwarded-Proto {scheme}
#     }
#     encode gzip zstd
# }
#
# After you buy the canonical domain:
# 1. Point DNS A (and optional AAAA) for qazshaqyru.kz → VPS IP
# 2. CNAME or redirect www.qazshaqyru.kz → apex (prefer apex as APP_URL)
# 3. Set APP_URL=https://qazshaqyru.kz (no trailing slash)
# 4. Switch Caddyfile to Option A
# 5. docker compose up -d caddy

# ---------------------------------------------------------------------------
# Option C: Direct app port (no Caddy) — debugging only
# ---------------------------------------------------------------------------
# docker compose up -d postgres app
# Expose app port temporarily in docker-compose.yml (not recommended for prod):
#   ports: ["3000:3000"]
# APP_URL=http://YOUR.VPS.IP:3000
# TRUST_PROXY=false only if nothing sits in front of the app
